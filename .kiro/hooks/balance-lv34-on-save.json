{
  "version": "v1",
  "hooks": [
    {
      "name": "Balance check on LV3-4 inputs save",
      "description": "Run the balance guard whenever the HAUNT ramp, tank upgrades or wall layout is saved.",
      "trigger": "PostFileSave",
      "matcher": "(src/ui/hauntLevel\\.js|src/mech/tankUpgrades\\.js|src/combat/obstacle\\.js)$",
      "action": {
        "type": "command",
        "command": "node scripts/kiro-hook-run.mjs balance-lv34-on-save -- node tests/combat/balance.test.js"
      },
      "timeout": 120
    }
  ]
}
